dex\":35,\"bbox\":[572.1599,758.08332,586.41029,769.60867608],\"precision\":\"block\",\"coordinate_system\":\"top_left_pdf_points\"}],\"tables\":[],\"supplements\":[],\"warnings\":[{\"code\":\"scope\",\"message\":\"OCR, visual figure/chart interpretation, and formula understanding are disabled. Reading order, spacing and table structure are parser estimates; review the original pages.\",\"page_indices\":[],\"source_ref\":null},{\"code\":\"printed_labels_unavailable\",\"message\":\"Printed page labels are not extracted; page indices refer to physical PDF pages.\",\"page_indices\":[],\"source_ref\":null},{\"code\":\"picture_not_interpreted\",\"message\":\"Picture content is omitted; native captions are retained.\",\"page_indices\":[35],\"source_ref\":\"#/pictures/47\"}]},\"document_labels\":[\"decision-trees\"],\"file_id\":\"cd6684c353e44c7c88e349fccb10f8d0\",\"file_name\":\"decision-trees.pdf\",\"chunk_id\":\"cd6684c353e44c7c88e349fccb10f8d0:parent:46\",\"text\":\"Avoiding overfitting\\n\\n·Usually we do not know in advance which are the irrelevant variables\\n\\n·…and it may depend on the context\\n\\nFor example, if y = a AND b then b is an irrelevant variable only in the portion of the tree in which a=0\\n\\nBut we can use simple statistics to warn us that we might be overfitting.\\n\\nCopyright ©Andrew W. Moore Slide 71\\n\\nCopyright ©Andrew W. Moore Slide 72\\n\\n36\",\"distance\":0.4558243751525879,\"fusion\":{\"chunk_id\":\"cd6684c353e44c7c88e349fccb10f8d0:child:171\",\"rrf_score\":0.029857397504456328,\"rank\":2,\"bm25_score\":6.049788638243449,\"bm25_rank\":8,\"vector_distance\":0.4558243751525879,\"vector_rank\":6},\"rerank\":{\"chunk_id\":\"cd6684c353e44c7c88e349fccb10f8d0:child:171\",\"rrf_score\":0.029857397504456328,\"rank\":2,\"bm25_score\":6.049788638243449,\"bm25_rank\":8,\"vector_distance\":0.4558243751525879,\"vector_rank\":6,\"rerank_score\":-1.5096373558044434,\"rerank_rank\":3,\"score_kind\":\"logit\",\"scoring_parent_id\":null},\"parent_id\":\