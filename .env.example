# Credentials and provider connection. Blank optional values use defaults.
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_TIMEOUT_SECONDS=600
OPENAI_MAX_RETRIES=2

# Local storage. Use a new directory when changing the embedding model.
DATA_DIR=data/v1
# Local Docling assets, installed separately; no OCR or provider calls.
PDF_MODEL_DIR=data/pdf-models

# Models. Blank RESOLVER_MODEL follows ANSWER_MODEL.
ANSWER_MODEL=gpt-4.1
# Optional; leave blank for models without reasoning support.
ANSWER_REASONING_EFFORT=
EMBEDDING_MODEL=text-embedding-3-small
RESOLVER_MODEL=

# Optional child reranking after RRF; requires RETRIEVAL_STRATEGY=hybrid.
RERANK_ENABLED=false
RERANK_UNIT=child
# Local cross-encoder; blank uses the same BGE default.
RERANK_MODEL=BAAI/bge-reranker-v2-m3
RERANK_DEVICE=auto
RERANK_BATCH_SIZE=4
RERANK_MAX_PAIR_TOKENS=1024
RERANK_CANDIDATE_LIMIT=20
RERANK_MAX_INPUT_TOKENS=16384

# Parent-child indexing. Initial budgets, not an evaluated optimum.
CHUNKING_STRATEGY=parent_child
CHUNK_MAX_TOKENS=512
CHUNK_TOKENIZER=cl100k_base

# Experimental only: CHUNKING_STRATEGY=semantic; structural parents stay unchanged.
# Split within paragraphs when adjacent sentence cosine similarity is below this value.
SEMANTIC_SIMILARITY_THRESHOLD=0.5
SEMANTIC_BATCH_SIZE=32

# Parent context limit; CHUNK_MAX_TOKENS above limits searchable children.
PARENT_MAX_TOKENS=1536
# Exact context, including source file/heading metadata, labels and separators.
EVIDENCE_MAX_TOKENS=4096
# Keep admitted parents, then fit whole selected children from omitted parents.
EVIDENCE_PACKING_STRATEGY=parent_then_child

# Character strategy only: set CHUNKING_STRATEGY=character for the MVP baseline.
CHUNK_SIZE=2048
CHUNK_OVERLAP=256
# Hybrid retrieval. Set RETRIEVAL_STRATEGY=vector for the vector-only control.
RETRIEVAL_STRATEGY=hybrid
RETRIEVAL_CANDIDATE_LIMIT=20
BM25_K1=1.2
BM25_B=0.75
RRF_K=60
# Selected children before parent expansion; this is not the number of sources.
RETRIEVAL_TOP_K=5
HISTORY_LIMIT=10

# Evaluation requests keep their own timeout and retry policy.
# JUDGE_MODEL is used by make eval and explicit grade --judge-model commands.
EVAL_TIMEOUT_SECONDS=60
EVAL_MAX_RETRIES=0
JUDGE_MODEL=gpt-5.4-mini
JUDGE_REASONING_EFFORT=high
JUDGE_CONCURRENCY=4

# Separate limit for the two-pass evaluation judge; each judge call uses this timeout.
JUDGE_TIMEOUT_SECONDS=180

# Optional independent-query planning; the chat checkbox can select this per request.
RETRIEVAL_MODE=single
# Blank uses ANSWER_MODEL. Must support Responses structured JSON output.
PLANNER_MODEL=
PLANNING__REQUEST_TIMEOUT_SECONDS=180
PLANNING__ANSWER_RESERVE_SECONDS=60
PLANNING__PLANNER_TIMEOUT_SECONDS=30
PLANNING__MAX_INPUT_TOKENS=8192
PLANNING__MAX_OUTPUT_TOKENS=2048
PLANNING__ANSWER_MAX_INPUT_TOKENS=16384
PLANNING__ANSWER_MAX_OUTPUT_TOKENS=4096
