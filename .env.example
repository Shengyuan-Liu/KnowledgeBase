# Credentials and provider connection. Blank optional values use defaults.
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_TIMEOUT_SECONDS=600
OPENAI_MAX_RETRIES=2

# Local storage. Use a new directory when changing the embedding model.
DATA_DIR=data

# Models. Blank RESOLVER_MODEL follows ANSWER_MODEL.
ANSWER_MODEL=gpt-4.1
EMBEDDING_MODEL=text-embedding-3-small
RESOLVER_MODEL=

# Indexing and retrieval. Chunk units are characters, not tokens.
CHUNK_SIZE=2048
CHUNK_OVERLAP=256
RETRIEVAL_TOP_K=5
HISTORY_LIMIT=10

# Evaluation requests keep their own timeout and retry policy.
# JUDGE_MODEL is used only with an explicit grade --judge-model command.
EVAL_TIMEOUT_SECONDS=60
EVAL_MAX_RETRIES=0
JUDGE_MODEL=gpt-4.1-mini
